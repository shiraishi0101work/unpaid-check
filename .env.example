# ========================================
# MFクラウド請求書 OAuth設定
# ※ MF開発者コンソール（下記URL）でアプリを作成して発行してください
# https://invoice.moneyforward.com/developer
# リダイレクトURIには「https://【ドメイン】/oauth/callback/invoice」を登録
# ========================================
MF_INVOICE_CLIENT_ID=ここにCLIENT_IDを入力
MF_INVOICE_CLIENT_SECRET=ここにCLIENT_SECRETを入力
MF_INVOICE_REDIRECT_URI=https://【ドメイン】/oauth/callback/invoice

# ========================================
# Webアプリ設定
# FLASK_SECRET_KEY は必ずランダムな文字列に変更してください
# 例: python -c "import secrets; print(secrets.token_hex(32))" で生成
# ========================================
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=必ずランダムな文字列に変更すること

# ========================================
# 定期自動実行スケジューラー（任意）
# SCHEDULE_ENABLED=true にすると平日9時に自動実行
# ========================================
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 9 * * 1-5
