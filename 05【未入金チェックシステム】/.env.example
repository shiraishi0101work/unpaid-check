# ========================================
# MFクラウド請求書 OAuth設定
# MF開発者コンソールで発行: https://invoice.moneyforward.com/developer
# ========================================
MF_INVOICE_CLIENT_ID=
MF_INVOICE_CLIENT_SECRET=
MF_INVOICE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# ========================================
# MFクラウド会計 OAuth設定
# MF開発者コンソールで発行: https://accounting.moneyforward.com/developer
# ========================================
MF_ACCOUNTING_CLIENT_ID=
MF_ACCOUNTING_CLIENT_SECRET=
MF_ACCOUNTING_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# ========================================
# 照合設定
# ========================================
# 金額照合の許容誤差（円）
MATCH_AMOUNT_TOLERANCE=0

# 着金日が請求日より何日前まで許容するか（通常は0）
MATCH_DATE_BEFORE_DAYS=0

# 着金日が支払期限より何日後まで許容するか（遅延入金も含める場合は大きく）
MATCH_DATE_AFTER_DAYS=365
