# ========================================
# MFクラウド請求書 OAuth設定
# ========================================
MF_INVOICE_CLIENT_ID=ここにCLIENT_IDを入力
MF_INVOICE_CLIENT_SECRET=ここにCLIENT_SECRETを入力
MF_INVOICE_REDIRECT_URI=http://localhost:5000/oauth/callback/invoice

# ========================================
# Webアプリ設定（ローカルテスト用）
# ========================================
PORT=5000
FLASK_DEBUG=true
FLASK_SECRET_KEY=local-dev-secret-key-change-this

# ========================================
# スケジューラー（ローカルテスト中は無効）
# ========================================
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 9 * * 1-5
