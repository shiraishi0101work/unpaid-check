# ========================================
# MFクラウド請求書 OAuth設定
# MF開発者コンソールで発行: https://invoice.moneyforward.com/developer
# リダイレクトURIに「http://localhost:5000/oauth/callback/invoice」を登録すること
# ========================================
MF_INVOICE_CLIENT_ID=
MF_INVOICE_CLIENT_SECRET=
MF_INVOICE_REDIRECT_URI=http://localhost:5000/oauth/callback/invoice

# ========================================
# MFクラウド会計 OAuth設定
# MF開発者コンソールで発行: https://accounting.moneyforward.com/developer
# リダイレクトURIに「http://localhost:5000/oauth/callback/accounting」を登録すること
# ========================================
MF_ACCOUNTING_CLIENT_ID=
MF_ACCOUNTING_CLIENT_SECRET=
MF_ACCOUNTING_REDIRECT_URI=http://localhost:5000/oauth/callback/accounting

# ========================================
# Webアプリ設定
# ========================================
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=change-me-to-a-random-string

# ========================================
# 定期自動実行スケジューラー
# SCHEDULE_ENABLED=true にすると自動実行が有効になる
# SCHEDULE_CRON は cron式（分 時 日 月 曜日）
# ========================================
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 9 * * 1-5

# ========================================
# 照合設定
# ========================================
MATCH_AMOUNT_TOLERANCE=0
MATCH_DATE_BEFORE_DAYS=0
MATCH_DATE_AFTER_DAYS=365
